      "description": "Controle, confiança e compromisso para organizar sua vida.",
      "themeColor": "#071629",
      "backgroundColor": "#F6F8FB",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/",
      "orientation": "portrait"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
